{
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv
	request_body {
		max_size 11MB
	}
	@wechatVerification path_regexp verification ^/MP_verify_[A-Za-z0-9_]+\.txt$
	handle @wechatVerification {
		root * /verification
		file_server
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		file_server
	}
	# Access logging intentionally disabled: OAuth callbacks contain authorization codes.
}
