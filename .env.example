# Copy to .env to override defaults. Never commit real secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
# Empty: npm run dev starts project-local PostgreSQL on 127.0.0.1:55432.
# Nonempty: dev/migrations use an existing PostgreSQL; they never stop it.
DATABASE_URL=
LOCAL_DB_PORT=55432
# Production requires DATABASE_URL; embedded PostgreSQL is development only.
# Windows only: optional ASCII directory for native program cache, not database data.
# STARLIT_LOCAL_DB_HOME=C:/starlit-runtime

# Auth: npm run dev sets defaults and generates .local/auth-secret automatically.
# Production: supply a secret of at least 64 characters and HTTPS origin securely.
# AUTH_SECRET=
# APP_ORIGIN=http://127.0.0.1:5173

# Private activity images; default is project .local/uploads in npm run dev.
# Production must supply an absolute persistent directory and back it up with the DB.
# ASSET_DIRECTORY=C:/starlit-data/uploads

# Separate 32-byte (64 hex characters) WeChat encryption master key.
# npm run dev creates .local/wechat-master-key. Never commit or print it.
# Production: inject through a secret manager, keep separate from database backups.
# WECHAT_MASTER_KEY=

# OAuth defaults to disabled. Enable wechat only after HTTPS + official account
# authorization-domain setup; no real credentials are used by the test suite.
# WECHAT_OAUTH_PROVIDER=disabled
# Domain verification files; API reads the same files served by the gateway.
# WECHAT_VERIFICATION_DIRECTORY=/var/lib/starlit/verification
# Test runner only: mock is forbidden outside development, and its AppIDs must
# start with mock_. Mock origin must be a loopback HTTP origin.
# WECHAT_MOCK_ORIGIN=http://127.0.0.1:19090
